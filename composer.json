{
    "name": "anderson/my-shopping-cart",
    "description": "A simple shopping cart application in PHP with clean architecture.",
    "type": "project",
    "license": "GNU General Public License v3.0",
    "require": {
        "php": ">=8.4",
        "php-di/php-di": "^7.0",
        "robmorgan/phinx": "^0.16.10",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "symfony/console": "^7.2",
        "twig/twig": "^3.19",
      "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "MyShoppingCart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyShoppingCart\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "scripts": {
        "test": "XDEBUG_MODE=coverage phpunit --coverage-clover coverage.xml",
        "test:html": "XDEBUG_MODE=coverage phpunit --coverage-html coverage-report"
    },
    "authors": [
        {
            "name": "Anderson Rezende",
            "email": "andersonrezende17@hotmail.com"
        }
    ]
}
